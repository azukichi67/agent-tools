# .env にコピーして使う。docker compose は `~` を展開しないため、
# SSH_PUBLIC_KEY_PATH は絶対パスで書く（Windowsはスラッシュ区切りでよい）。
# リポジトリのディレクトリ名が日本語等でcompose側のproject名が空になる環境があるため、
# COMPOSE_PROJECT_NAME は明示しておく。

COMPOSE_PROJECT_NAME=agent-dev
PROJECT_NAME=agent-dev
SSH_PORT=2222
SSH_PUBLIC_KEY_PATH=C:/Users/you/.ssh/id_ed25519.pub
