# .env にコピーして使う

# ディレクトリ名が日本語だと compose の project 名が空になるため明示する。
# volume 名の接頭辞にもなるので、範囲（コンテナ）ごとに変える
COMPOSE_PROJECT_NAME=agent-dev

# 範囲ごとにずらす
SSH_PORT=2222

# 既定（~/.ssh/id_ed25519.pub）と違う公開鍵を使うときだけ書く
# SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# この一式を別ディレクトリにコピーして使うときだけ、agent-tools リポジトリの場所を書く
# AGENT_TOOLS_DIR=C:/Users/you/orca/agent-tools
